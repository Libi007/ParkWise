# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-parkwise-secret-key

# Database Configuration (SQLite default; PostgreSQL ready)
DATABASE_URL=sqlite:///parkwise.db

# Machine Learning Model Configuration
MODEL_PATH=artifacts/parkwise_lightgbm_model.pkl
MODEL_NAME=LightGBM-Regressor-Tuned
MODEL_VERSION=1.0.0

# Timezone Configuration (The Hague / Scheveningen dataset)
PARKWISE_TIMEZONE=Europe/Amsterdam

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Port
PORT=5000
